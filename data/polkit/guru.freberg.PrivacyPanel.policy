<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Privacy Panel</vendor>
  <action id="guru.freberg.PrivacyPanel.helper">
    <description>Change system-wide privacy settings</description>
    <message>Privacy Panel needs the administrator password to change system-wide privacy settings.</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/privacy-panel/privacy-panel-helper</annotate>
  </action>
</policyconfig>
